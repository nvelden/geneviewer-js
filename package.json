{
  "name": "geneviewer-js",
  "version": "0.3.7",
  "description": "Interactive gene cluster, transcript and genome alignment charts in the browser, drawn with D3",
  "keywords": [
    "gene cluster",
    "genome",
    "synteny",
    "transcript",
    "bioinformatics",
    "visualization",
    "d3",
    "chart"
  ],
  "homepage": "https://nvelden.github.io/geneviewer-docs/",
  "bugs": {
    "url": "https://github.com/nvelden/geneviewer-js/issues"
  },
  "license": "MIT",
  "author": "Niels van der Velden",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/nvelden/geneviewer-js.git"
  },
  "module": "./dist/geneviewer.mjs",
  "types": "./dist/geneviewer.d.ts",
  "unpkg": "./dist/geneviewer.min.js",
  "jsdelivr": "./dist/geneviewer.min.js",
  "exports": {
    ".": {
      "types": "./dist/geneviewer.d.ts",
      "import": "./dist/geneviewer.mjs"
    },
    "./standalone": {
      "types": "./dist/geneviewer.d.ts",
      "import": "./dist/geneviewer.standalone.mjs"
    },
    "./geneviewer.css": "./dist/geneviewer.css",
    "./spec-v1.schema.json": "./dist/spec-v1.schema.json",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE.md",
    "LICENSE-THIRD-PARTY.md"
  ],
  "sideEffects": [
    "*.css"
  ],
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "d3": "^7.8.5"
  },
  "scripts": {
    "check": "node scripts/check.mjs",
    "build": "node scripts/build.mjs && node scripts/build-types.mjs && node scripts/sums.mjs",
    "try-app": "bash scripts/try-app.sh",
    "test": "bash scripts/test-docker.sh",
    "test:update": "bash scripts/test-docker.sh --update",
    "test:compile": "node test/compile.mjs",
    "test:smoke": "node test/smoke/run.mjs",
    "schema:check": "node scripts/schema-check.mjs",
    "spec:check": "node scripts/spec-check.mjs",
    "types": "node scripts/build-types.mjs",
    "types:test": "tsc -p test/types/tsconfig.json",
    "types:src": "tsc -p jsconfig.json"
  },
  "devDependencies": {
    "ajv": "8.20.0",
    "esbuild": "0.28.2",
    "json-schema-to-typescript": "16.0.0",
    "playwright-core": "1.64.1",
    "typescript": "7.0.2"
  }
}
