{
  "name": "geneviewer-js",
  "version": "0.3.0-alpha.1",
  "description": "D3 rendering library shared by the geneviewer R and Python packages",
  "license": "MIT",
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/nvelden/geneviewer-js.git"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "d3": "^7.8.5"
  },
  "scripts": {
    "check": "node scripts/check.mjs",
    "build": "node scripts/build.mjs && node scripts/build-types.mjs && node scripts/sums.mjs",
    "try-app": "bash scripts/try-app.sh",
    "site": "node scripts/build.mjs && node scripts/build-site.mjs",
    "serve": "npm run -s site && python3 -m http.server 8484 --bind 127.0.0.1 --directory _site",
    "test": "bash scripts/test-docker.sh",
    "test:update": "bash scripts/test-docker.sh --update",
    "test:compile": "node test/compile.mjs",
    "schema:check": "node scripts/schema-check.mjs",
    "spec:check": "node scripts/spec-check.mjs",
    "types": "node scripts/build-types.mjs",
    "types:test": "tsc -p test/types/tsconfig.json",
    "types:src": "tsc -p jsconfig.json"
  },
  "devDependencies": {
    "ajv": "8.20.0",
    "esbuild": "0.28.2",
    "json-schema-to-typescript": "16.0.0",
    "playwright-core": "1.64.1",
    "typescript": "7.0.2"
  }
}
