{"id":"mitochondrial-gene-order-locust-and-human","code":"# Rotate each circular genome to start at COX1, preserving genomic spacing,\n# and label reverse-strand genes with a leading minus, as in the published\n# figure. The original coordinates are kept for the tooltips.\ngenes <- mitochondrial_gene_order %>%\n  group_by(cluster) %>%\n  mutate(genomic_start = start, genomic_end = end,\n         plot_start = (start - start[gene == \"COX1\"]) %% genome_length + 1,\n         plot_end = plot_start + end - start,\n         label = ifelse(strand == \"complement\", paste0(\"-\", gene), gene)) %>%\n  ungroup()\n\ngenomes <- distinct(genes, cluster, genome_length)\ncolors <- list(\"Conserved flanks\" = \"#D9D5D2\",\n               \"ND4L / ND4 / ND5\" = \"#F22228\", ND6 = \"#FFF000\",\n               CYTB = \"#00AC52\", \"RNS / RNL / ND1\" = \"#36328C\")\n\nchart <- GC_chart(genes, start = \"plot_start\", end = \"plot_end\",\n                  cluster = \"cluster\", group = \"block\", strand = \"strand\",\n                  height = \"320px\") %>%\n  GC_genes(marker = \"box\", markerHeight = 18, arrowheadHeight = 18,\n           cornerRadius = 0) %>%\n  # A negative spacing puts reverse-strand genes above the baseline and\n  # forward-strand genes below it, as in the published figure.\n  GC_cluster(separate_strands = TRUE, strand_spacing = -18) %>%\n  # The labels go on one line below the genes, with a line to each gene\n  GC_labels(\"label\", fontStyle = \"normal\", adjustLabels = \"spread\",\n            leaderLine = list(length = 12)) %>%\n  GC_color(customColors = colors) %>%\n  GC_scale(axis_type = \"range\", hidden = TRUE) %>%\n  GC_grid(margin = list(top = 0, bottom = 0)) %>%\n  GC_clusterFooter(\n    title = genomes$cluster,\n    subtitle = paste0(\"13 proteins; 2 rRNAs; \",\n                      format(genomes$genome_length, big.mark = \",\"), \" bp\"),\n    align = \"left\", y = 10\n  ) %>%\n  GC_title(\"Mitochondrial gene order: locust and human\",\n           subtitle = paste(\"Redrawn from Fig. 3 of Jameson et al. (2003),\",\n                            \"Nucleic Acids Res 31:202-206\"),\n           titleFont = list(fontSize = \"19px\")) %>%\n  GC_tooltip(formatter = paste0(\"<b>{gene}<\/b>: {product}<br>{cluster}<br>\",\n                                \"RefSeq: {accession}<br>\",\n                                \"Original coordinates: {genomic_start} - {genomic_end} ({strand})\")) %>%\n  GC_legend(FALSE) %>%\n  GC_theme(\"publication\", fontFamily = \"Courier New, Courier, monospace\")\nchart","height":"320px","width":"100%","spec":{"version":1,"data":{"cluster":["Locusta migratoria","Locusta migratoria","Locusta migratoria","Locusta migratoria","Locusta migratoria","Locusta migratoria","Locusta migratoria","Locusta migratoria","Locusta migratoria","Locusta migratoria","Locusta migratoria","Locusta migratoria","Locusta migratoria","Locusta migratoria","Locusta migratoria","Homo sapiens","Homo sapiens","Homo sapiens","Homo sapiens","Homo sapiens","Homo sapiens","Homo sapiens","Homo sapiens","Homo sapiens","Homo sapiens","Homo sapiens","Homo sapiens","Homo sapiens","Homo sapiens","Homo sapiens"],"accession":["NC_001712.1","NC_001712.1","NC_001712.1","NC_001712.1","NC_001712.1","NC_001712.1","NC_001712.1","NC_001712.1","NC_001712.1","NC_001712.1","NC_001712.1","NC_001712.1","NC_001712.1","NC_001712.1","NC_001712.1","NC_012920.1","NC_012920.1","NC_012920.1","NC_012920.1","NC_012920.1","NC_012920.1","NC_012920.1","NC_012920.1","NC_012920.1","NC_012920.1","NC_012920.1","NC_012920.1","NC_012920.1","NC_012920.1","NC_012920.1"],"genome_length":[15722,15722,15722,15722,15722,15722,15722,15722,15722,15722,15722,15722,15722,15722,15722,16569,16569,16569,16569,16569,16569,16569,16569,16569,16569,16569,16569,16569,16569,16569],"gene":["COX1","COX2","ATP8","ATP6","COX3","ND3","ND5","ND4","ND4L","ND6","CYTB","ND1","RNL","RNS","ND2","COX1","COX2","ATP8","ATP6","COX3","ND3","ND4L","ND4","ND5","ND6","CYTB","RNS","RNL","ND1","ND2"],"prod